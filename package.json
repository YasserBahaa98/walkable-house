{
  "name": "walkable-house",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mlightcad/libredwg-web": "^0.8.4",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "three": "^0.187.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "description": "Turn house plans (DWG, DXF or images) into an editable 3D home you can walk through. Offline-first PWA.",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dxf-parser": "^1.1.2"
  }
}
